+-- A worker without a checker can consult the same state as the Control API.
+-- No target-list lock, counter read, timer or event subscription is needed.
+function _M.get_shared_target_status(name, shm_name, ip, port, hostname)
+  local state = ngx.shared[shm_name]:get(key_for(SHM_PREFIX .. name .. ":state",
+                                                  ip, port, hostname or ip))
+  if state == nil then
+    return nil
+  end
+  return state == INTERNAL_STATES.healthy or state == INTERNAL_STATES.mostly_healthy
 end
 
 
