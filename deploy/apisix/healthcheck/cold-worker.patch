+-- Only used until this worker's timer installs its own checker. A snapshot is
+-- keyed by current node order and excluded indices; it must never seed the
+-- normal picker cache for a live checker.
+function _M.shared_balancer_status(upstream)
+    local conf = config_local.local_conf()
+    if conf and conf.apisix and conf.apisix.disable_upstream_healthcheck then
+        return
+    end
+
+    healthcheck = healthcheck or require("resty.healthcheck")
+    local active = upstream.checks.active or {}
+    local name = get_healthchecker_name(upstream)
+    local excluded, status = {}, {}
+    for i, node in ipairs(upstream.nodes) do
+        local ok = healthcheck.get_shared_target_status(name, healthcheck_shdict_name,
+                                    node.host, active.port or node.port, active.host)
+        status[node.host .. ":" .. node.port] = ok ~= false
+        if ok == false then
+            excluded[#excluded + 1] = i
+        end
+    end
+
+    -- Unknown targets remain usable. APISIX also retains its configured
+    -- fail-open behaviour when every target is unhealthy.
+    if #excluded > 0 and #excluded < #upstream.nodes then
+        return status, table.concat(excluded, ",")
+    end
+end
